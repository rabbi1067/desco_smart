# =============================================================================
# DESCO Smart — .gitignore
# Covers the Next.js app and the Python monitoring worker.
# =============================================================================

# --- Environment / secrets (NEVER commit real values) ------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# .env.example is intentionally committed (placeholders only).
!.env.example

# --- Node / Next.js ----------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.turbo/
.swc/
*.tsbuildinfo
next-env.d.ts

# --- Vercel ------------------------------------------------------------------
.vercel/

# --- Python (monitor/) -------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Logs --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing / coverage ------------------------------------------------------
coverage/
.nyc_output/

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
