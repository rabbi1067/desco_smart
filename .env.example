# =============================================================================
# DESCO Smart — example environment
#
# Copy to .env.local (Next.js) / set as GitHub Actions secrets. NEVER commit real
# values. This file contains PLACEHOLDERS ONLY and is safe to commit; real .env
# files are git-ignored (see .gitignore).
#
# Two consumers share these variables:
#   - the Next.js app (browser + server)
#   - the Python monitoring worker in monitor/ (server only)
#
# ABOUT NEXT_PUBLIC_*  ---------------------------------------------------------
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore PUBLIC. Only put non-secret values here. The Supabase anon key is
# designed to be public (it is constrained by Row Level Security); the
# service-role key is NOT and must never be given a NEXT_PUBLIC_ prefix.
# =============================================================================

# --- Supabase: browser-exposed (PUBLIC, non-secret) --------------------------
# Your project URL and the anon/public key. Safe to ship to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --- Supabase: server-only (SECRET) ------------------------------------------
# Service-role key bypasses Row Level Security. Used by the Next.js server and by
# the Python worker. NEVER expose to the browser; NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Project URL for the Python worker. Same value as NEXT_PUBLIC_SUPABASE_URL; kept
# as its own (non-public) name so the worker does not depend on NEXT_PUBLIC_*.
SUPABASE_URL=https://your-project-ref.supabase.co

# --- Cloudinary: image storage (SECRET where noted) --------------------------
# Used by the Next.js server to upload avatars via a signed request. The cloud
# name is public; the API key/secret are server-only. NEVER prefix with
# NEXT_PUBLIC_ and never expose the secret to the browser. If any of the three
# is unset, the app simply hides the upload button and keeps the URL field.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- SMTP / email (SECRET where noted; used by the worker to send alerts) -----
# If EMAIL_USER / EMAIL_PASS are unset, the worker records alerts but sends no
# email (it will not crash).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-smtp-username@example.com
EMAIL_PASS=your-smtp-password-or-app-password
EMAIL_FROM_NAME=DESCO Smart

# --- App URLs: browser-exposed (PUBLIC, non-secret) --------------------------
# Public base URL of the deployed site (used for links in the UI/emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
